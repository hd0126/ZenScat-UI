      "legacy_entry": "ZENSCAT_MAIN/app5_Casual_ImportClass.m",
      "status": "supported",
      "gui_support": "implemented",
      "inputs": ["ER", "sub_L", "x", "Lx", "NH", "Lam0", "Theta", "n_sup", "n_sub", "polarization", "matrix_method"],
      "outputs": ["device.ER", "device.ERC", "device.sub_L", "grid", "TRN", "REF"],
      "supported": [
        "legacy RCWA_DATA.mat files",
        "trusted RCWA_DATA.py.npy dictionaries",
        "S/T matrix execution",
        "E/H polarization",
        "MATLAB-compatible result bundle export"
      ],
      "security_policy": "NumPy pickle dictionaries require trusted_pickle=True or an explicit GUI import action."
    },
    {
      "id": "casual_phc_rcwa",
      "legacy_entry": "ZENSCAT_MAIN/app2_CasualClass.m; ZENSCAT_MAIN/Device_3.m; ZENSCAT_MAIN/Launch_RCWA_S_PhC.m",
      "status": "supported",
      "gui_support": "implemented",
      "inputs": ["Params", "PhC interface", "PhC interface params", "layer_count", "NH", "Lam0", "Theta", "n_sup", "n_sub", "polarization", "repeat_mode"],
      "outputs": ["device.ER", "device.ERC", "device.sub_L", "top/bottom cap layers", "TRN", "REF"],
      "supported": [
        "PhC_rec_square rectangle",
        "PhC_rec_circ ellipse/circle",
        "PhC_hex_columns hex columns",
        "E mode",
        "H mode",
        "legacy S-matrix PhC path",
        "legacy repeat bug mode",
        "corrected repeat mode"
      ],
      "notes": [
        "The live legacy rectangle GUI zero-width wiring is repaired by requiring positive rectangle widths.",
        "Angles are passed in radians in the Python workflow metadata."
      ]
    },
    {
      "id": "optimization",
      "legacy_entry": "ZENSCAT_MAIN/app3_OptimizeClass.m; ZENSCAT_MAIN/Merit_Function3.m; ZENSCAT_MAIN/Merit_Function_Import.m",
      "status": "supported",
      "gui_support": "implemented",
      "inputs": ["bounds", "objective", "polarization", "NH", "sweep", "analytic or imported device"],
      "outputs": ["best parameters", "fitness", "termination status", "history", "final physical RCWA run", "export bundle"],
      "supported": [
        "R(-1)",
        "R(0)",
        "R(+1)",
        "T(-1)",
        "T(0)",
        "T(+1)",
        "Absorption",
        "Gain",
        "deterministic scipy.differential_evolution",
        "cancellation",
        "final physical S-matrix RCWA verification/export"
      ],
      "not_claimed": [
        "MATLAB proprietary GA trajectory compatibility",
        "legacy +/-2 dropdown objectives because the MATLAB merit functions never implemented them"
      ]
    },
    {
      "id": "fdfd_fields",
      "legacy_entry": "ZENSCAT_MAIN/app4_CalcFieldsClass.m; ZENSCAT_MAIN/Grid_FDFD.m; ZENSCAT_MAIN/Device_FDFD.m; ZENSCAT_MAIN/FDFD_2D.m",
      "status": "supported",
      "gui_support": "implemented",
      "inputs": ["Params_FDFD", "interface", "polarization", "Lam0_um", "Theta", "grid resolution", "PML", "material palette"],
      "outputs": ["TRN", "REF", "f", "ER2", "Python FDFD export bundle"],
      "supported": [
        "sin interface",
        "DE1 trapezium interface",
        "DE4 super-Gaussian interface",
        "tri triangle interface",
        "all/two distribution",
        "periodic replication",
        "E mode",
        "H mode",
        "raw field f",
        "ER2 device field",
        "material palette dispersion legacy_fdfd mode",
        "material palette dispersion corrected_um mode"
      ],
      "not_claimed": [
        "Device_FDFD_PhC.m branch",
        "MATLAB-defined FDFD file export schema; Python defines zenscat.fdfd-result-bundle"
      ]
    }
  ],
