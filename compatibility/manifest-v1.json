{
  "schema": "zenscat.compatibility-manifest",
  "schema_version": "1.0",
  "legacy_source_commit": "b2867d1",
  "production_runtime": "Python; MATLAB is oracle-only",
  "matlab_oracle": {
    "release": "R2024b",
    "fixture_directory": "tests/golden",
    "generators": [
      "matlab_oracle/generate_golden_fixtures.m",
      "matlab_oracle/generate_device_variant_goldens.m",
      "matlab_oracle/generate_optimization_golden.m",
      "matlab_oracle/generate_fdfd_golden.m",
      "matlab_oracle/generate_phc_golden.m"
