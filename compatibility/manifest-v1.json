  "legacy_quirks": [
    {
      "id": "fdfd-final-sweep-sum",
      "status": "verified",
      "policy": "Preserve the legacy scalar sum from the final wavelength/angle sweep point and identify it as legacy_final_sweep_sum metadata."
    },
    {
      "id": "fdfd-ref-trn-minus1-alias",
      "status": "verified",
      "policy": "Preserve the legacy REF.TRN_minus1 alias in FDFD compatibility fields and metadata rather than silently renaming it."
    },
    {
      "id": "fdfd-dispersion-unit-behavior",
      "status": "verified",
      "policy": "Default to legacy_fdfd material-palette evaluation, which follows MATLAB's 1e6*Lam0 behavior; expose corrected_um explicitly for micrometre-corrected evaluation."
    },
    {
      "id": "phc-non-power-of-two-repeat",
      "status": "verified",
      "policy": "Expose repeat_mode='legacy' to reproduce Launch_RCWA_S_PhC.m and repeat_mode='corrected' for exact layer repetition."
    },
    {
      "id": "phc-rectangle-zero-width-live-wiring",
      "status": "verified",
      "policy": "Reject zero rectangle widths and use repaired positive-width GUI controls; the broken legacy live wiring is not reproduced."
    },
    {
      "id": "broken-device-fdfd-phc-branch",
      "status": "verified-in-source",
      "policy": "Exclude Device_FDFD_PhC.m because it references undefined identifiers and lacks a stable public result contract."
    },
    {
      "id": "optimizer-plus-minus-two-dropdown-options",
      "status": "verified-in-source",
      "policy": "Do not expose +/-2 objective choices as supported because Merit_Function3.m and Merit_Function_Import.m do not implement them."
    },
    {
      "id": "matlab-ga-trajectory",
      "status": "not-claimed",
      "policy": "Match objective semantics and final physical S-run outputs; do not claim deterministic equality with MATLAB's proprietary GA trajectory."
    },
    {
      "id": "tm-normalization-differs-between-s-and-t",
      "status": "verified",
      "policy": "Preserve each legacy method's formula and test S and T independently."
    },
    {
      "id": "matlab-rounding-indexing-orientation",
      "status": "verified",
      "policy": "Preserve MATLAB rounding, indexing, and single-axis MAT orientation in geometry, solver, and result round-trip tests."
    }
  ],
  "release_claims": {
