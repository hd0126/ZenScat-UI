  },
  "length_units": {
    "analytic_geometry": "um",
    "rcwa_solver_wavelength": "m",
    "imported_sub_L": "um",
    "rcwa_solver_sub_L": "m",
    "fdfd_geometry": "um",
    "fdfd_wavelength": "um",
    "angles": "rad"
  },
  "public_result_fields": {
    "rcwa": {
      "TRN": ["minus_1", "plus_1", "TRN0", "sum"],
      "REF": ["minus_1", "plus_1", "REF0", "sum"]
    },
    "fdfd": {
      "TRN": ["TRN_minus1", "TRN_plus1", "TRN0", "sum"],
      "REF": ["TRN_minus1", "REF_plus1", "REF0", "sum"],
      "raw_field": "f",
      "device_field": "ER2"
    }
  },
  "export_schemas": [
    {
      "schema": "zenscat.result-bundle",
      "workflows": ["casual_rcwa", "custom_import_rcwa", "casual_phc_rcwa", "optimization"],
      "files": ["TRN.mat", "REF.mat", "Lam.mat", "Theta.mat", "manifest.json"],
      "optional_files": ["Output.mat", "Params.mat"],
      "units": {"wavelength": "m", "angle": "rad"}
    },
    {
      "schema": "zenscat.fdfd-result-bundle",
      "workflows": ["fdfd_fields"],
      "files": ["TRN.mat", "REF.mat", "Lam.mat", "Theta.mat", "Field.mat", "ER2.mat", "manifest.json"],
      "optional_files": ["Params.mat"],
      "units": {"wavelength": "um", "angle": "rad", "field": "raw_solver_units"}
    }
  ],
  "workflows": [
    {
      "id": "casual_rcwa",
      "legacy_entry": "ZENSCAT_MAIN/app2_CasualClass.m",
      "status": "supported",
      "gui_support": "implemented",
      "inputs": ["Params", "interface", "distribution", "Lx", "h", "Nx", "Nz", "NH", "Lam0", "Theta", "n_sup", "n_sub", "polarization", "matrix_method"],
      "outputs": ["device.ER", "device.ERC", "device.sub_L", "grid", "TRN", "REF"],
      "supported": [
        "S matrix",
        "T matrix",
        "E mode",
        "H mode",
        "sin interface",
        "DE1 trapezium interface",
        "DE4 super-Gaussian interface",
        "tri triangle interface",
        "all/two layer distribution",
        "periodic replication",
        "legacy MATLAB indexing and rounding"
